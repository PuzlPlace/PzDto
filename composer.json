{
    "name": "puzl/pzdto",
    "description": "DTO por herança (extends PzDto) com cast automático, aninhamento de DTO/enum, validações por atributo e rastreamento de alterações — sucessor da FromArrayTrait.",
    "type": "library",
    "license": "proprietary",
    "keywords": ["dto", "data-transfer-object", "validation", "attributes", "laravel", "eloquent", "puzl"],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/pagination": "^10.0|^11.0|^12.0|^13.0",
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "illuminate/database": "Para ler Eloquent Models campo a campo em Dto::from($model) e Dto::collect($models)"
    },
    "autoload": {
        "psr-4": {
            "Puzl\\PzDto\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Puzl\\PzDto\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml.dist",
        "test:coverage": "phpunit -c phpunit.xml.dist --coverage-text",
        "bench": "php benchmarks/from.php"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
